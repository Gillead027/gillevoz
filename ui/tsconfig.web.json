{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*",
    "src/preload/*.d.ts"
  ],
  "exclude": ["src/renderer/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx"
  }
}
